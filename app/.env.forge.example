# Electron Forge Deployment Configuration
# Copy this file to .env.forge and fill in your values

# Apple Code Signing (for macOS builds)
# APPLE_ID=your-apple-id@example.com
# APPLE_PASSWORD=your-app-specific-password
# APPLE_TEAM_ID=your-team-id

# GitHub Repository (for publishing)
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=keynotai2
# GITHUB_TOKEN=your-github-token

# Windows Code Signing (for Windows builds)
# WIN_CSC_LINK=path-to-certificate.p12
# WIN_CSC_KEY_PASSWORD=certificate-password

# General
# NODE_ENV=production 