# All settings are optional. LLM provider API keys are NOT configured here —
# use the in-app LLM Settings dialog (stored in {userData}/llm-settings.json).

# Logging Configuration
# Enable/disable all logging (default: false)
LOG_ENABLED=false

# Enable AI-specific logging for debugging agent interactions (default: false)
AI_LOGGING_ENABLED=false

# Log to file (default: true when logging is enabled)
LOG_TO_FILE=true

# Log to console (default: true)
LOG_TO_CONSOLE=true

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Create separate conversation-only log file with clean format (default: true when logging enabled)
CONVERSATION_LOG_ENABLED=true

# Image generation (optional)
# The generateImage tool uses the Google AI key from the settings dialog;
# these environment variables are a fallback if no Google provider is configured.
# GEMINI_API_KEY=your-google-ai-api-key
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
