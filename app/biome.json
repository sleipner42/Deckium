{
    "$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noNonNullAssertion": "off",
                "useImportType": "off"
            },
            "suspicious": {
                "noExplicitAny": "off"
            },
            "correctness": {
                "useExhaustiveDependencies": "off"
            },
            "complexity": {
                "noStaticOnlyClass": "off"
            },
            "nursery": {
                "useSortedClasses": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "src/renderer/application/components/presentation/**"
            ],
            "linter": {
                "rules": {
                    "a11y": {
                        "noStaticElementInteractions": "off",
                        "useKeyWithClickEvents": "off",
                        "noSvgWithoutTitle": "off",
                        "noNoninteractiveTabindex": "off"
                    }
                }
            }
        }
    ],
    "formatter": {
        "enabled": true,
        "formatWithErrors": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "semicolons": "always"
        }
    },
    "json": {
        "formatter": {
            "enabled": true
        }
    }
}
